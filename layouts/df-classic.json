                    },
                    {
                      "id": "agents",
                      "type": "block",
                      "size": {
                        "weight": 1
                      },
                      "min": 90,
                      "content": {
                        "mod": "df-classic",
                        "props": {
                          "role": "agents"
                        }
                      }
                    }
                  ]
                },
