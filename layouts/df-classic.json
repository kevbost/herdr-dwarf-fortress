                            "content": {
                              "mod": "df-classic",
                              "props": {
                                "role": "pane"
                              }
                            },
                            "height": 18,
                            "position": "top",
                            "reveal": "always"
                          }
                        }
                      }
                    },
                    {
                      "id": "panel",
                      "type": "column",
                      "hidden": true,
